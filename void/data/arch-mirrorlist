# Default mirror list installed by the Spaces dev install on Void, only when
# /etc/pacman.d/mirrorlist does not exist. Void packages do not provide this
# file. Creating an Arch space with the `rankmirrors` option rewrites it
# ("# Ranked by Spaces"); pacstrap copies it into the new guest.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
