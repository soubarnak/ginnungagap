# AppArmor profile for Spaces guests running under LXC on Void Linux.
# Based on LXC's lxc-container-default-cgns, extended so a full systemd guest
# can build its unit sandboxes (ProtectSystem=, PrivateTmp=, ...), which rbind
# the guest root and remount it. Stock LXC profiles deny that, and
# systemd-logind then fails to start. Load with: apparmor_parser -r <file>
# Replaces the SELinux confinement used by upstream on Fedora.
#
# The name starts with "lxc-" on purpose. Void's /etc/apparmor.d/usr.bin.lxc-start is loaded at boot
# (runit core service 09-apparmor.sh) and confines /usr/bin/lxc-start; it only allows
# `change_profile -> lxc-*` (and unconfined), and it has no local include to extend. A profile with
# any other name makes the launch fail with "Failed to write AppArmor profile". Keep the prefix.

#include <tunables/global>

profile lxc-spaces-container flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/lxc/container-base>

  deny mount fstype=devpts,
  mount fstype=cgroup2 -> /sys/fs/cgroup/**,
  mount fstype=overlay,
  mount fstype=ext*,
  mount fstype=xfs,
  mount fstype=btrfs,
  mount fstype=tmpfs,
  mount fstype=fuse*,
  # Not allowed on purpose: a fresh proc or sysfs mount (systemd tries both for
  # PrivateNetwork=, ProtectProc= and PrivatePIDs=, and falls back to the existing
  # mounts when they are refused), nor the legacy cgroup v1 filesystem. A fresh proc
  # mounted anywhere shows the host's writable /proc/sys, and the guest has no user
  # namespace that would keep it read-only (core_pattern is a host-wide root command).

  # systemd unit sandboxing: bind, rbind, remount and move mounts inside the guest.
  mount options=(rw, rbind) / -> /run/systemd/**,
  mount options=(rw, bind) /** -> /**,
  mount options=(rw, rbind) /** -> /**,
  mount options=(ro, bind) /** -> /**,
  mount options=(ro, remount, bind) -> /**,
  mount options=(rw, remount, bind) -> /**,
  mount options=(rw, remount, bind, nosuid, nodev, noexec) -> /**,
  mount options=(remount, bind, nosuid, nodev, noexec, ro) -> /**,
  mount options=(remount, bind, nosuid, nodev, noexec, ro, nosymfollow) -> /**,
  mount options=(rw, rslave) -> /**,
  mount options=(rw, rprivate) -> /**,
  mount options=(rw, rshared) -> /**,
  mount options=(rw, move) /** -> /**,
  # move_mount(2) from an fd (systemd 258+ credentials) has no source path.
  mount options=(rw, move) -> /**,
  umount,
  pivot_root,
}
